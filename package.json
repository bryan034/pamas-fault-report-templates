{
  "name": "report-formatter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test:entry": "node --experimental-strip-types --test tests/report-entry.test.mjs",
    "dev:tunnel": "docker compose --env-file .env --env-file .env.tunnel -f compose.yaml -f compose.tunnel.yaml up -d",
    "test:devdocker": "node --test tests/dev-docker.test.mjs",
    "dev:quick": "node scripts/quick-https.mjs start",
    "dev:quick:stop": "node scripts/quick-https.mjs stop",
    "test:quick": "node --test tests/quick-https.test.mjs",
    "test:access": "node --experimental-strip-types --test tests/tunnel-config.test.mjs",
    "test:ids": "node --experimental-strip-types --test tests/create-id.test.mjs",
    "test:deployment": "node --experimental-strip-types --test tests/cloudflare-deployment.test.mjs",
    "build:cloudflare": "node scripts/cloudflare.mjs build",
    "deploy:cloudflare:web": "node scripts/cloudflare.mjs deploy-web",
    "deploy:cloudflare:api": "node scripts/cloudflare.mjs deploy-api",
    "test:ocr": "node --experimental-strip-types --test tests/template-ocr.test.mjs",
    "test:templates": "PLAYWRIGHT_BROWSERS_PATH=.playwright playwright test",
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 0.0.0.0 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "pdfjs-dist": "^5.6.205",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
