# Copy to .env and replace with a long URL-safe random password before docker compose up.
FAULT_REPORT_DB_PASSWORD=replace-with-a-long-random-password

# Explicit local-only no-login mode. Set google to test real application login.
TEMPLATE_ACCESS_MODE=local
TEMPLATE_OWNER_EMAIL=bry.io456@gmail.com
TEMPLATE_PUBLIC_ORIGIN=http://localhost:5173
TEMPLATE_AUTH_ORIGIN=http://localhost:8001
# Google Cloud OAuth client: Web application. Never commit real credentials.
# Authorized redirect URI: http://localhost:8001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Background DOCX-to-PDF conversion (the editor remains the field-box builder).
# Generate with: openssl rand -hex 32. Use the SAME secret in Python and Docs.
ONLYOFFICE_JWT_SECRET=
# Pin a tested image tag/digest before production deployment.
ONLYOFFICE_IMAGE_TAG=9.3.1

# Alembic upgrades before startup. Set false only after a separate migration job.
TEMPLATE_MIGRATE_ON_START=true
