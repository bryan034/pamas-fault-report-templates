# Optional: copy to .env.quick (git-ignored), or pass emails to npm run dev:quick.
# Use real mailboxes you can receive one-time codes at, separated by commas.
# Every approved tester has editing access to your existing testing data.
QUICK_TEST_ACCESS=email
# Explicit opt-in: public removes ALL login and permits anyone to edit/delete.
# QUICK_TEST_ACCESS=public
QUICK_TEST_ALLOWED_EMAILS=
