# Copy to .env.tunnel. Do not commit that file or share/log its tunnel token.
# Local database password stays in .env; these settings do not move data to cloud.
TUNNEL_TOKEN=
# Application administrator (Google sign-in email); never a browser-supplied role.
TEMPLATE_OWNER_EMAIL=bry.io456@gmail.com
# Example team domain: your-team.cloudflareaccess.com (no https://).
ACCESS_TEAM_DOMAIN=
# Access application audience, a 64-character lowercase hexadecimal value.
ACCESS_AUD=
# Example: https://reports-dev.yourdomain.com (no path or trailing slash).
TEMPLATE_PUBLIC_ORIGIN=
