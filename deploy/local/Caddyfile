{
    auto_https disable_redirects
    skip_install_trust
    # IP clients often omit SNI; select the certificate for the chosen Wi-Fi IP.
    default_sni {$LOCAL_HTTPS_DEFAULT_SNI:127.0.0.1}
}

{$LOCAL_HTTPS_HOSTS:https://localhost:5173, https://127.0.0.1:5173} {
    tls internal

    # One HTTPS origin avoids mixed-content/CORS failures on Wi-Fi devices.
    handle /api/* {
        reverse_proxy template-service:8000
    }
    handle {
        reverse_proxy web:8787
    }
}
